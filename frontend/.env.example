# Environment variables SERVER-SIDE untuk Vercel Functions.
# Set via Vercel Dashboard → Project → Settings → Environment Variables
# (JANGAN pakai prefix VITE_; nilainya tidak boleh bocor ke browser).

# URL Web App Google Apps Script (backend)
JOURNAL_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Shared token API Google Apps Script (samakan dengan API_TOKEN di backend)
JOURNAL_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password login aplikasi
JOURNAL_PASSWORD=ganti-dengan-password-kuat

# Kunci penandatangan cookie sesi (string acak, min 32 karakter)
AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
